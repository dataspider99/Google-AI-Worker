# Johny Sins – systemd unit
# Install: sudo cp systemd/johny-sins.service /etc/systemd/system/
#         sudo systemctl daemon-reload
#         sudo systemctl enable --now johny-sins
# Logs:   journalctl -u johny-sins -f

[Unit]
Description=Johny Sins – AI workflows for Gmail, Chat & Drive
Documentation=https://github.com/your-org/Johny-Sins
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user

WorkingDirectory=/home/ec2-user/Johny-Sins

# Load .env from project root and auth (optional; - prefix = don't fail if missing)
EnvironmentFile=-/home/ec2-user/Johny-Sins/.env
EnvironmentFile=-/home/ec2-user/Johny-Sins/auth/.env
Environment=ENVIRONMENT=production
Environment=PORT=8002
# Set ENABLE_DOCS=true in .env or here to serve /docs and /redoc in production
Environment=ENABLE_DOCS=true

# Run uvicorn from project venv
ExecStart=/home/ec2-user/Johny-Sins/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002

Restart=on-failure
RestartSec=5

# Security / resource limits (optional)
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=johny-sins

[Install]
WantedBy=multi-user.target
